{
  "name": "@getbourdon/conformance",
  "version": "0.1.0",
  "description": "Language-neutral cross-implementation parity fixtures for Bourdon. Python (pip install bourdon) is the oracle; the @getbourdon/* TypeScript mirror asserts against these exact bytes.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "homepage": "https://bourdon.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getbourdon/bourdon-js.git",
    "directory": "packages/conformance"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "private": true
}
